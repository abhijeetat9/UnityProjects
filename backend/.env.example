# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cabboo?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed origins for the web client
CORS_ORIGIN=http://localhost:5173
